{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-key.json",
      "**/.*",
      "**/node_modules/**",
      "*.zip",
      "test-*.js",
      "*.log"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
